// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Register(in=in, load=load, out=out1);
    Inc16(in=outf , out=out2 );
    Register(in=out2 , load=inc , out=out3 );
    DFF(in=load , out=load2 );
    Mux16(a=out3 , b=out1 , sel=load2 , out=out5 );
    Xor16(a=in, b=in, out=out4);
    DFF(in=reset, out=reset2);
    Mux16(a=out5, b=out4, sel=reset2, out=outf, out=out);
}