// File name: projects/2/Inc16.hdl
/**
 * 16-bit incrementer:
 * out = in + 1
 */
CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    Not16(in=in , out=out1 );
    Nand16(a=in, b=out1, out=out2);
    Add16(a=out1 , b=out2 , out=out3 );
    Not16(in=out3, out=out);
}